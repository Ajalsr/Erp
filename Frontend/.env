# ─── Required: copy this file to .env and fill in real values ───────────────
# .env is listed in .gitignore — NEVER commit real credentials to source control.

# MongoDB Atlas connection string
# Get this from: Atlas dashboard → Connect → Drivers → copy the URI
# Replace <username>, <password>, and <cluster> with your actual values.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/products?retryWrites=true&w=majority&appName=Cluster0

# JWT signing secret — must be a long random string (32+ characters)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string_at_least_32_characters

# Server port (optional — defaults to 8080)
PORT=8080
