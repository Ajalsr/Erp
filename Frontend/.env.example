# Frontend → backend API base URL.
# Desktop (Tauri sidecar) defaults to localhost when unset.
# Mobile (Android/iOS) MUST point at a reachable host — phones can't hit
# the desktop's localhost. Set this to your deployed backend before building mobile.
#
#   Desktop dev:   leave unset (uses http://localhost:8080)
#   Android/prod:  https://api.yourdomain.com
#VITE_API_URL=https://api.yourdomain.com
VITE_API_URL=https://nexus-afcd.onrender.com
