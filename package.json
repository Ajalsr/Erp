{
  "name": "nexus",
  "version": "1.0.0",
  "description": "Nexus All-in-One",
  "license": "ISC",
  "author": "Nexus",
  "type": "commonjs",
  "scripts": {
    "predev": "kill-port 8080 || true",
    "dev": "tauri dev",
    "dev:web": "concurrently -n \"API,UI\" -c \"blue,green\" --kill-others-on-fail \"cd backend && backend.exe\" \"npm --prefix Frontend run dev\"",
    "build": "npm run build:backend && tauri build",
    "build:backend": "node scripts/build-backend.js",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "concurrently": "^9.2.0",
    "kill-port": "^2.0.1",
    "wait-on": "^8.0.3"
  }
}
