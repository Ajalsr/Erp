# Copy this file to `.env` (in this backend/ directory) and fill in values.
# `go run .` loads backend/.env automatically via the loader package (godotenv).
# .env is gitignored — never commit real credentials.

# ── MongoDB (REQUIRED) ───────────────────────────────────────────────
# App fatals on boot if this is empty. Atlas or local.
# Atlas:  mongodb+srv://user:pass@cluster.mongodb.net/products?retryWrites=true&w=majority
# Local:  mongodb://localhost:27017/products
# NOTE: the actual database used is "ERP" (config.GetCollection hardcodes it),
# the path in the URI is ignored.
MONGO_URI=

# ── JWT (REQUIRED) ───────────────────────────────────────────────────
# Signing secret for auth tokens — long random string (32+ chars).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ── Server ───────────────────────────────────────────────────────────
PORT=8080
# Frontend base URL — used for invite links and CORS.
APP_URL=http://localhost:5175
# Comma-separated allowed CORS origins (optional; defaults applied if empty).
ALLOWED_ORIGINS=

# ── Cloudinary (image uploads: letterhead, stamp, logos) ─────────────
# Uploads fail without these; the rest of the app runs fine.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── SMTP Email (optional) ────────────────────────────────────────────
# Sends invitation + letter emails. If empty, invites still work via the
# copy-link flow in the UI — email is just skipped silently.
# Gmail: enable 2-Step Verification → myaccount.google.com → Security →
#        App Passwords → create one for "Mail" → paste as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
# Display name in the From header (defaults to SMTP_USER if empty).
SMTP_FROM=your-email@gmail.com

# ── Admin (optional) ─────────────────────────────────────────────────
# Shared secret gating admin-only endpoints.
ADMIN_SECRET=
