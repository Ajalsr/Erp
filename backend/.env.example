# ── SMTP Email Configuration ─────────────────────────────────────────
# Used to send invitation emails. If left empty, invites still work via
# the copy-link flow in the UI — email is just skipped silently.
#
# Gmail setup:
#   1. Enable 2-Step Verification on your Google account
#   2. Go to myaccount.google.com → Security → App Passwords
#   3. Create an app password for "Mail" → paste it as SMTP_PASS
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Display name in the From header (defaults to SMTP_USER if empty)
SMTP_FROM=your-email@gmail.com

# Frontend base URL — used to build the invite link in the email
APP_URL=http://localhost:5175
