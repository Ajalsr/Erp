# Copy this file to `.env` (in this backend/ directory) and fill in values.
# `go run .` loads backend/.env automatically via the loader package (godotenv).
# .env is gitignored — never commit real credentials.

# ── MongoDB (REQUIRED) ───────────────────────────────────────────────
# App fatals on boot if this is empty. Atlas or local.
# Atlas:  mongodb+srv://user:pass@cluster.mongodb.net/products?retryWrites=true&w=majority
# Local:  mongodb://localhost:27017/products
# NOTE: the actual database used is "ERP" (config.GetCollection hardcodes it),
# the path in the URI is ignored.
MONGO_URI=

# ── JWT (REQUIRED) ───────────────────────────────────────────────────
# Signing secret for auth tokens — long random string (32+ chars).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ── Server ───────────────────────────────────────────────────────────
PORT=8080
# Marketing/download site URL — used for the invitation email link only
# (that page just hands off to the desktop app or the installer, no API
# calls). Also seeds CORS.
APP_URL=http://localhost:5175
# Standalone public document viewer (Spifora-site/public-viewer) — used for
# invoice/quote/bill/letter "view online" links, which DO need a live API.
# Deploy that project separately (its own subdomain, e.g. view.spifora.com)
# and point this at it. Falls back to APP_URL, then localhost, if unset.
PUBLIC_VIEWER_URL=
# Comma-separated allowed CORS origins — MUST include PUBLIC_VIEWER_URL's
# domain (it's a different origin than APP_URL, so APP_URL alone won't
# cover it) or the viewer's fetches get rejected with 403.
ALLOWED_ORIGINS=

# ── Cloudinary (image uploads: letterhead, stamp, logos) ─────────────
# Uploads fail without these; the rest of the app runs fine.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── SMTP Email (optional) ────────────────────────────────────────────
# Sends invitation + letter emails. If empty, invites still work via the
# copy-link flow in the UI — email is just skipped silently.
# Gmail: enable 2-Step Verification → myaccount.google.com → Security →
#        App Passwords → create one for "Mail" → paste as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
# Display name in the From header (defaults to SMTP_USER if empty).
SMTP_FROM=your-email@gmail.com

# ── Admin (optional) ─────────────────────────────────────────────────
# Shared secret gating admin-only endpoints.
ADMIN_SECRET=345667
